# MAS_Topo 实验环境变量配置
# 复制本文件为 .env 并填入真实密钥后，实验脚本会自动 source 本文件。
# .env 已被 .gitignore 忽略，不会进入版本控制。
#
# 约定：每个模型使用独立的环境变量名，避免与系统普通 OPENAI_API_KEY 混淆。

# DeepSeek API（用于 model=deepseek）
export DEEPSEEK_API_KEY="your-deepseek-api-key"
export DEEPSEEK_BASE_URL="https://api.deepseek.com"

# 硅基流动 SiliconFlow API（用于 model=qwen3）
export QWEN3_API_KEY="your-siliconflow-api-key"
export QWEN3_BASE_URL="https://api.siliconflow.cn/v1"

# OpenRouter API（用于 model=gptoss120b，实际请求 openai/gpt-oss-120b）
export GPT_OSS_120B_API_KEY="your-openrouter-api-key"
export GPT_OSS_120B_BASE_URL="https://openrouter.ai/api/v1"
